{
  "version": "1",
  "updated_at": "2026-10-30",
  "category": "probabilistic",
  "modules": [
    {
      "id": "prob-loot",
      "version": "1.0.2",
      "title": "Probabilistic Loot",
      "description": "ProbLog-annotated drop probabilities layered on top of loot-tables. Query the exact probability an item drops, compute expected yields, and build drop-rate UIs without any LLM calls. Requires loot-tables in the same namespace.",
      "category": "probabilistic",
      "license": "Elastic-2.0",
      "tags": [
        "loot",
        "probability",
        "rpg",
        "problog",
        "games"
      ],
      "predicates": [
        "drop_occurs/2",
        "guaranteed_drop/2",
        "drop_probability/3",
        "expected_drops/4"
      ],
      "requires": [
        "loot-tables"
      ],
      "rules_url": "https://raw.githubusercontent.com/datagrout/logic-batteries/main/modules/probabilistic/prob-loot/prob_loot.pl",
      "readme_url": "https://github.com/datagrout/logic-batteries/tree/main/modules/probabilistic/prob-loot",
      "install": "batteries.install_many",
      "tests_file": "test/probabilistic/prob_loot_test.pl",
      "inputs": [
        {
          "role": "item",
          "kind": "attribute",
          "name": "drop_chance",
          "type": "number",
          "presence": "key",
          "note": "Drop chance in percent; at 100 or more the item always drops from its sources."
        }
      ],
      "reads": {
        "drop_occurs/2": [],
        "guaranteed_drop/2": [
          "attribute(drop_chance)"
        ],
        "drop_probability/3": [],
        "expected_drops/4": []
      }
    },
    {
      "id": "prob-detection",
      "version": "1.0.1",
      "title": "Probabilistic Detection",
      "description": "Guard perception and stealth probability. Annotates detection likelihood based on perception tier, alert state, environmental conditions (light, weather, noise), and player stealth bonus. Requires combat in the same namespace.",
      "category": "probabilistic",
      "license": "Elastic-2.0",
      "tags": [
        "stealth",
        "detection",
        "probability",
        "rpg",
        "problog",
        "games"
      ],
      "predicates": [
        "detected/2",
        "detection_probability/3",
        "stealth_success/2",
        "environmental_detection_factor/2"
      ],
      "requires": [
        "combat"
      ],
      "rules_url": "https://raw.githubusercontent.com/datagrout/logic-batteries/main/modules/probabilistic/prob-detection/prob_detection.pl",
      "readme_url": "https://github.com/datagrout/logic-batteries/tree/main/modules/probabilistic/prob-detection",
      "install": "batteries.install_many",
      "tests_file": "test/probabilistic/prob_detection_test.pl",
      "inputs": [
        {
          "role": "npc",
          "kind": "attribute",
          "name": "perception",
          "type": "number",
          "presence": "key",
          "note": "Guard perception on a 1-10 scale: above 8 is the high tier, above 5 medium, else low; without it the base is 0.5 active, 0.3 passive."
        },
        {
          "role": "npc",
          "kind": "attribute",
          "name": "alert_state",
          "type": {
            "enum": [
              "active",
              "passive"
            ]
          },
          "presence": "key",
          "note": "active when the guard is alerted; passive, any other value or none counts as unalerted."
        },
        {
          "role": "npc",
          "kind": "attribute",
          "name": "faction",
          "type": "atom",
          "presence": "optional",
          "note": "The guard's faction, matched against a held item's disguise_faction."
        },
        {
          "role": "player",
          "kind": "attribute",
          "name": "stealth_bonus",
          "type": "number",
          "presence": "key",
          "note": "Stealth on a 0-10 scale, cutting detection by 0.07 a point down to a 0.1 factor; none counts as 0."
        },
        {
          "role": "player",
          "kind": "relation",
          "name": "has_item",
          "type": {
            "ref": "item"
          },
          "presence": "key",
          "note": "An item the player holds, read for the disguise rule."
        },
        {
          "role": "item",
          "kind": "attribute",
          "name": "disguise_faction",
          "type": "atom",
          "presence": "key",
          "note": "The faction the item passes its holder off as; a match drops an unalerted guard's base to 0.10."
        },
        {
          "role": {
            "fixed": "world"
          },
          "kind": "attribute",
          "name": "light_level",
          "type": {
            "enum": [
              "dark",
              "dim",
              "bright"
            ]
          },
          "presence": "optional",
          "note": "dark multiplies detection by 0.5 and dim by 0.75; bright or none leaves it."
        },
        {
          "role": {
            "fixed": "world"
          },
          "kind": "attribute",
          "name": "weather",
          "type": "atom",
          "presence": "optional",
          "note": "rain multiplies detection by 0.8 and fog by 0.85; other weather leaves it."
        },
        {
          "role": {
            "fixed": "world"
          },
          "kind": "attribute",
          "name": "noise_level",
          "type": {
            "enum": [
              "silent",
              "ambient",
              "loud"
            ]
          },
          "presence": "optional",
          "note": "loud multiplies detection by 1.3; silent, ambient or none leaves it."
        }
      ],
      "reads": {
        "detected/2": [],
        "detection_probability/3": [
          "attribute(alert_state)",
          "attribute(disguise_faction)",
          "attribute(faction)",
          "attribute(light_level)",
          "attribute(noise_level)",
          "attribute(perception)",
          "attribute(stealth_bonus)",
          "attribute(weather)",
          "relation(has_item)"
        ],
        "stealth_success/2": [
          "attribute(alert_state)",
          "attribute(disguise_faction)",
          "attribute(faction)",
          "attribute(light_level)",
          "attribute(noise_level)",
          "attribute(perception)",
          "attribute(stealth_bonus)",
          "attribute(weather)",
          "relation(has_item)"
        ],
        "environmental_detection_factor/2": [
          "attribute(light_level)",
          "attribute(noise_level)",
          "attribute(weather)"
        ]
      }
    },
    {
      "id": "prob-economy",
      "version": "1.0.1",
      "title": "Probabilistic Economy",
      "description": "Market uncertainty for simulation games. Models supply disruption and demand spike probabilities from world state (weather, seasons, conflict), then derives price ranges and expected prices. Requires economy in the same namespace.",
      "category": "probabilistic",
      "license": "Elastic-2.0",
      "tags": [
        "economy",
        "market",
        "probability",
        "simulation",
        "problog",
        "games"
      ],
      "predicates": [
        "supply_disruption/2",
        "demand_spike/2",
        "price_range/4",
        "market_volatility/3",
        "expected_price/2"
      ],
      "requires": [
        "economy"
      ],
      "rules_url": "https://raw.githubusercontent.com/datagrout/logic-batteries/main/modules/probabilistic/prob-economy/prob_economy.pl",
      "readme_url": "https://github.com/datagrout/logic-batteries/tree/main/modules/probabilistic/prob-economy",
      "install": "batteries.install_many",
      "tests_file": "test/probabilistic/prob_economy_test.pl",
      "inputs": [
        {
          "role": "item",
          "kind": "attribute",
          "name": "import_dependent",
          "type": "bool",
          "presence": "key",
          "note": "true when the item relies on imports: storms, a blocked route and winter disrupt its supply."
        },
        {
          "role": "item",
          "kind": "attribute",
          "name": "perishable",
          "type": "bool",
          "presence": "key",
          "note": "true when the item spoils: storms and summer disrupt its supply."
        },
        {
          "role": "item",
          "kind": "attribute",
          "name": "category",
          "type": "atom",
          "presence": "key",
          "note": "healing, weapons, food or tools pick the demand rules that apply; any other category never spikes."
        },
        {
          "role": {
            "fixed": "world"
          },
          "kind": "attribute",
          "name": "weather",
          "type": "atom",
          "presence": "optional",
          "note": "storm disrupts import-dependent and perishable supply; other weather does nothing here."
        },
        {
          "role": {
            "fixed": "world"
          },
          "kind": "attribute",
          "name": "season",
          "type": "atom",
          "presence": "optional",
          "note": "winter disrupts imports and raises food demand, summer disrupts perishables; absent, no season rule applies."
        },
        {
          "role": {
            "fixed": "world"
          },
          "kind": "attribute",
          "name": "trade_route_blocked",
          "type": "bool",
          "presence": {
            "default": "false"
          },
          "note": "true disrupts import-dependent supply and raises demand for tools."
        },
        {
          "role": {
            "fixed": "world"
          },
          "kind": "attribute",
          "name": "recent_conflict",
          "type": "bool",
          "presence": {
            "default": "false"
          },
          "note": "true raises demand for healing items and weapons."
        },
        {
          "role": {
            "fixed": "world"
          },
          "kind": "attribute",
          "name": "threat_rising",
          "type": "bool",
          "presence": {
            "default": "false"
          },
          "note": "true raises demand for healing items and weapons."
        }
      ],
      "reads": {
        "supply_disruption/2": [
          "attribute(import_dependent)",
          "attribute(perishable)",
          "attribute(season)",
          "attribute(trade_route_blocked)",
          "attribute(weather)"
        ],
        "demand_spike/2": [
          "attribute(category)",
          "attribute(recent_conflict)",
          "attribute(season)",
          "attribute(threat_rising)",
          "attribute(trade_route_blocked)"
        ],
        "price_range/4": [
          "attribute(category)",
          "attribute(import_dependent)",
          "attribute(perishable)",
          "attribute(recent_conflict)",
          "attribute(season)",
          "attribute(threat_rising)",
          "attribute(trade_route_blocked)",
          "attribute(weather)"
        ],
        "market_volatility/3": [
          "attribute(category)",
          "attribute(import_dependent)",
          "attribute(perishable)",
          "attribute(recent_conflict)",
          "attribute(season)",
          "attribute(threat_rising)",
          "attribute(trade_route_blocked)",
          "attribute(weather)"
        ],
        "expected_price/2": [
          "attribute(category)",
          "attribute(import_dependent)",
          "attribute(perishable)",
          "attribute(recent_conflict)",
          "attribute(season)",
          "attribute(threat_rising)",
          "attribute(trade_route_blocked)",
          "attribute(weather)"
        ]
      }
    },
    {
      "id": "prob-npc",
      "version": "1.0.0",
      "title": "Probabilistic NPC Trust",
      "description": "NPC belief and trust probability based on faction standing and relationship score. Query the likelihood an NPC will share information, assist with tasks, or offer a price discount. Requires npc-state and faction in the same namespace.",
      "category": "probabilistic",
      "license": "Elastic-2.0",
      "tags": [
        "npc",
        "trust",
        "probability",
        "rpg",
        "problog",
        "games"
      ],
      "predicates": [
        "trust_probability/3",
        "will_share_info/3",
        "will_assist/3",
        "npc_price_modifier/3",
        "disposition_probability/3"
      ],
      "requires": [
        "faction",
        "npc-state"
      ],
      "rules_url": "https://raw.githubusercontent.com/datagrout/logic-batteries/main/modules/probabilistic/prob-npc/prob_npc.pl",
      "readme_url": "https://github.com/datagrout/logic-batteries/tree/main/modules/probabilistic/prob-npc",
      "install": "batteries.install_many",
      "tests_file": "test/probabilistic/prob_npc_test.pl",
      "inputs": [
        {
          "role": "npc",
          "kind": "attribute",
          "name": "faction",
          "type": "atom",
          "presence": "key",
          "note": "The npc's faction: trust starts from the player's standing with it, or 0.35 without one."
        },
        {
          "role": "npc",
          "kind": "relation",
          "name": "knows_topic",
          "type": {
            "ref": "topic"
          },
          "presence": "key",
          "note": "A topic the npc can share at all."
        },
        {
          "role": "npc",
          "kind": "relation",
          "name": "can_assist",
          "type": {
            "ref": "task"
          },
          "presence": "key",
          "note": "A task the npc can help with at all."
        },
        {
          "role": "topic",
          "kind": "attribute",
          "name": "sensitivity",
          "type": {
            "enum": [
              "low",
              "medium",
              "high",
              "secret"
            ]
          },
          "presence": "key",
          "note": "How guarded the topic is: each step lowers the sharing weight and from medium up needs a closer relationship; none is the most open."
        },
        {
          "role": "task",
          "kind": "attribute",
          "name": "assistance_cost",
          "type": {
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "presence": "key",
          "note": "What the favour costs the npc: each step lowers the assist weight and from medium up needs a closer relationship; none is the cheapest."
        }
      ],
      "reads": {
        "trust_probability/3": [
          "attribute(faction)"
        ],
        "will_share_info/3": [],
        "will_assist/3": [],
        "npc_price_modifier/3": [
          "attribute(faction)"
        ],
        "disposition_probability/3": [
          "attribute(faction)"
        ]
      }
    },
    {
      "id": "prob-core-iso",
      "version": "1.0.0",
      "license": "Apache-2.0",
      "title": "ProbLog Core (ISO)",
      "description": "ProbLog-lite runtime for ISO-pinned (Scryer) cells. Weighted P::Head rules are rewritten to reified prob_rule(Head, P) clauses at install/assert time; this battery provides the pure-ISO combinators over them: noisy-or psuccess, legacy pmax, negation, conjunction, and expected value. Enables the other prob-* batteries on ISO namespaces without SWI escalation.",
      "category": "probabilistic",
      "tags": [
        "probability",
        "problog",
        "iso",
        "scryer",
        "runtime",
        "core"
      ],
      "predicates": [
        "psuccess/2",
        "pmax/2",
        "pnot/2",
        "pand/2",
        "expected/3",
        "prob_or/2"
      ],
      "rules_url": "https://raw.githubusercontent.com/datagrout/logic-batteries/main/modules/probabilistic/prob-core-iso/prob_core_iso.pl",
      "readme_url": "https://github.com/datagrout/logic-batteries/tree/main/modules/probabilistic/prob-core-iso",
      "install": "batteries.install_many",
      "tests_file": "test/probabilistic/prob_core_iso_test.pl"
    },
    {
      "id": "prob-decide",
      "version": "1.0.0",
      "title": "Decision Theory (DTProbLog-lite)",
      "description": "Expected-utility decision layer over prob-core-iso. Declare action/1 candidates, weighted P::outcome(Action, Outcome) rules, and utility/2 values; eu/2 scores each action as sum(P*U) over its outcomes and best_action/2 picks the argmax. Pure ISO \u2014 runs on pinned (Scryer) cells.",
      "category": "probabilistic",
      "license": "Elastic-2.0",
      "tags": [
        "probability",
        "decision-theory",
        "expected-utility",
        "dtproblog",
        "iso",
        "scryer"
      ],
      "predicates": [
        "eu/2",
        "eu_sum/3",
        "best_action/2",
        "best_pair/5"
      ],
      "requires": [
        "prob-core-iso"
      ],
      "rules_url": "https://raw.githubusercontent.com/datagrout/logic-batteries/main/modules/probabilistic/prob-decide/prob_decide.pl",
      "readme_url": "https://github.com/datagrout/logic-batteries/tree/main/modules/probabilistic/prob-decide",
      "install": "batteries.install_many",
      "tests_file": "test/probabilistic/prob_decide_test.pl"
    }
  ]
}
