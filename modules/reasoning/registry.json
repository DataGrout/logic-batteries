    {
      "id": "explain",
      "version": "1.0.0",
      "title": "Explain / Provenance",
      "description": "Proof-tree meta-interpreter for stored rules and facts: ask not just whether a goal holds but which facts made it true. why/2 gives a deterministic flat list of supporting base/stored facts (the everyday API); explain/2 gives full proof trees with alternatives on backtracking. Handles conjunction, disjunction, if-then-else, negation-as-failure, and whitelisted builtins. Pure ISO \u2014 runs on pinned (Scryer) cells.",
      "category": "reasoning",
      "tags": [
        "provenance",
        "explanation",
        "proof-tree",
        "meta-interpreter",
        "audit",
        "iso",
        "scryer"
      ],
      "predicates": [
        "why/2",
        "explain/2",
        "expl_prove/2",
        "expl_leaves/3",
        "expl_base/1",
        "expl_builtin/1"
      ],
      "rules_url": "https://raw.githubusercontent.com/datagrout/logic-batteries/main/modules/reasoning/explain/explain.pl",
      "readme_url": "https://github.com/datagrout/logic-batteries/tree/main/modules/reasoning/explain",
      "install": "batteries.install_many",
      "tests_file": "test/reasoning/explain_test.pl"
    },
    {
      "id": "fixpoint",
      "version": "1.0.1",
      "title": "Fixpoint Evaluation",
      "description": "Bottom-up (Datalog-style) saturation of stored rules: tabling's termination benefit without tabling. Textbook recursive rules \u2014 transitive closure, left-recursive ancestry \u2014 work verbatim on cyclic data where plain resolution loops; recursive subgoals are looked up in the growing answer set, each answer derived exactly once. Pure ISO \u2014 runs on SWI and Scryer alike, including ISO-pinned cells where :- table is unavailable.",
      "category": "reasoning",
      "tags": [
        "fixpoint",
        "datalog",
        "tabling",
        "termination",
        "recursion",
        "iso",
        "scryer"
      ],
      "predicates": [
        "fixpoint_solve/1",
        "fixpoint_solve/2",
        "fixpoint_answers/2",
        "fixpoint_answers/3"
      ],
      "rules_url": "https://raw.githubusercontent.com/datagrout/logic-batteries/main/modules/reasoning/fixpoint/fixpoint.pl",
      "readme_url": "https://github.com/datagrout/logic-batteries/tree/main/modules/reasoning/fixpoint",
      "install": "batteries.install_many",
      "tests_file": "test/reasoning/fixpoint_test.pl"
    },
    {
      "id": "assign",
      "version": "1.0.1",
      "title": "Assign",
      "description": "Budgeted constraint search over cell facts: variables with domains, all-different groups, and reject/pair/cost hooks whose bodies can call any other battery. Returns one consistent assignment, the cheapest by branch and bound, or the violations in a given assignment. Explicit node budget; small instances.",
      "category": "reasoning",
      "tags": [
        "constraints",
        "assignment",
        "search",
        "optimisation",
        "rostering",
        "reasoning"
      ],
      "predicates": [
        "assign_domain/2",
        "assign_solve/2",
        "assign_solve/3",
        "assign_best/3",
        "assign_violations/2",
        "assign_reject/2",
        "assign_reject_pair/4",
        "assign_cost/3"
      ],
      "rules_url": "https://raw.githubusercontent.com/datagrout/logic-batteries/main/modules/reasoning/assign/assign.pl",
      "readme_url": "https://github.com/datagrout/logic-batteries/tree/main/modules/reasoning/assign",
      "install": "batteries.install_many",
      "tests_file": "test/reasoning/assign_test.pl",
      "probes": [
        {
          "predicate": "assign_domain/2",
          "facts": [
            "attribute(s1, domain, [a, b, c])"
          ],
          "goal": "assign_domain(s1, D)",
          "expect": "D == [a, b, c]"
        },
        {
          "predicate": "assign_solve/2",
          "facts": [
            "attribute(s1, domain, [a, b, c])",
            "attribute(s2, domain, [a, b, c])",
            "attribute(s3, domain, [a, b, c])",
            "relation(day, distinct, s1)",
            "relation(day, distinct, s2)",
            "relation(day, distinct, s3)"
          ],
          "goal": "assign_solve([s1, s2, s3], R)",
          "expect": "R = solution(A, _), findall(X, member(_-X, A), Xs), msort(Xs, [a, b, c])"
        },
        {
          "predicate": "assign_solve/3",
          "facts": [
            "attribute(s1, domain, [a, b, c])",
            "attribute(s2, domain, [a, b, c])",
            "attribute(s3, domain, [a, b, c])",
            "relation(day, distinct, s1)",
            "relation(day, distinct, s2)",
            "relation(day, distinct, s3)"
          ],
          "goal": "assign_solve([s1, s2, s3], 100, R)",
          "expect": "R = solution(_, N), N > 0"
        },
        {
          "predicate": "assign_solve/2",
          "facts": [
            "attribute(s1, domain, [a, b])",
            "attribute(s2, domain, [a, b])",
            "attribute(s3, domain, [a, b])",
            "relation(day, distinct, s1)",
            "relation(day, distinct, s2)",
            "relation(day, distinct, s3)"
          ],
          "goal": "assign_solve([s1, s2, s3], R)",
          "expect": "R = unsat(_)"
        },
        {
          "predicate": "assign_best/3",
          "facts": [
            "attribute(s1, domain, [a, b, c])"
          ],
          "goal": "assign_best([s1], 100, R)",
          "expect": "R = best([s1-b], 1, _, complete)",
          "rules": [
            "assign_cost(s1, V, C) :- member(V-C, [a-5, b-1, c-3])."
          ]
        },
        {
          "predicate": "assign_violations/2",
          "facts": [
            "attribute(s1, domain, [a, b, c])",
            "attribute(s2, domain, [a, b, c])",
            "attribute(s3, domain, [a, b, c])",
            "relation(day, distinct, s1)",
            "relation(day, distinct, s2)",
            "relation(day, distinct, s3)"
          ],
          "goal": "assign_violations([s1-a, s2-a], V)",
          "expect": "V \\== []"
        }
      ]
    }
  ]
}
