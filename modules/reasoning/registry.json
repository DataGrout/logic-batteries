{
  "version": "1",
  "updated_at": "2026-10-30",
  "category": "reasoning",
  "modules": [
    {
      "id": "fsm",
      "version": "1.1.0",
      "title": "Finite State Machine",
      "description": "General-purpose FSM reasoning library. Assert machine structure once; query reachability, determinism, dead states, shortest paths, and structural issues at zero token cost. Supports runtime trace recording and cycle detection.",
      "category": "reasoning",
      "license": "Elastic-2.0",
      "tags": [
        "fsm",
        "state-machine",
        "reasoning",
        "agents"
      ],
      "predicates": [
        "fsm_state/2",
        "fsm_current_state/2",
        "fsm_initial_state/2",
        "fsm_terminal_state/2",
        "fsm_transition/4",
        "fsm_reachable/3",
        "fsm_reachable_states/2",
        "fsm_deterministic/1",
        "fsm_nondeterministic_state/3",
        "fsm_dead_state/2",
        "fsm_unreachable_state/2",
        "fsm_complete/1",
        "fsm_stuck/1",
        "fsm_stuck_at/2",
        "fsm_visited/2",
        "fsm_trace/4",
        "fsm_trace_length/2",
        "fsm_cycle/2",
        "fsm_shortest_path/4",
        "fsm_all_paths/4",
        "fsm_machines/1",
        "fsm_validate/2"
      ],
      "rules_url": "https://raw.githubusercontent.com/datagrout/logic-batteries/main/modules/reasoning/fsm/fsm.pl",
      "readme_url": "https://github.com/datagrout/logic-batteries/tree/main/modules/reasoning/fsm",
      "install": "platform",
      "tests_file": "test/fsm_test.pl",
      "inputs": [
        {
          "role": "machine",
          "kind": "relation",
          "name": "has_state",
          "type": {
            "ref": "state"
          },
          "presence": "key",
          "note": "A state this machine owns; edges and reachability stay within the machine's own states."
        },
        {
          "role": "machine",
          "kind": "attribute",
          "name": "machine_type",
          "type": {
            "enum": [
              "fsm"
            ]
          },
          "presence": "optional",
          "note": "fsm lists the machine in fsm_machines; nothing else reads it."
        },
        {
          "role": "machine",
          "kind": "attribute",
          "name": "current_state",
          "type": {
            "ref": "state"
          },
          "presence": "optional",
          "note": "The live state, for fsm_complete, fsm_stuck and fsm_stuck_at."
        },
        {
          "role": "machine",
          "kind": "relation",
          "name": "visited",
          "type": {
            "ref": "state"
          },
          "presence": "optional",
          "note": "A state the machine has been in, as fsm_visited reports it."
        },
        {
          "role": "machine",
          "kind": "relation",
          "name": "trace_step",
          "type": {
            "ref": "step"
          },
          "presence": "optional",
          "note": "One recorded step of the run; fsm_trace lists them in the order the facts were asserted."
        },
        {
          "role": "state",
          "kind": "relation",
          "name": "transitions_to",
          "type": {
            "ref": "state"
          },
          "presence": "key",
          "note": "An exit from this state to another state of the same machine."
        },
        {
          "role": "state",
          "kind": "attribute",
          "name": "state_type",
          "type": {
            "enum": [
              "initial",
              "terminal"
            ]
          },
          "presence": "key",
          "note": "initial marks where reachability starts; terminal marks an accepting state, which is not dead without exits."
        },
        {
          "role": "state",
          "kind": "attribute",
          "name": "on",
          "type": "atom",
          "presence": "optional",
          "note": "An event this state's exits fire on (events sit on states, not edges); absent reads as unspecified."
        },
        {
          "role": "step",
          "kind": "attribute",
          "name": "from_state",
          "type": {
            "ref": "state"
          },
          "presence": "key",
          "note": "The state the step left."
        },
        {
          "role": "step",
          "kind": "attribute",
          "name": "to_state",
          "type": {
            "ref": "state"
          },
          "presence": "required",
          "note": "The state the step entered; a step without one is left out of the trace."
        },
        {
          "role": "step",
          "kind": "attribute",
          "name": "event",
          "type": "atom",
          "presence": {
            "default": "unspecified"
          },
          "note": "The event that triggered the step."
        }
      ],
      "reads": {
        "fsm_state/2": [
          "relation(has_state)"
        ],
        "fsm_current_state/2": [
          "attribute(current_state)"
        ],
        "fsm_initial_state/2": [
          "attribute(state_type)",
          "relation(has_state)"
        ],
        "fsm_terminal_state/2": [
          "attribute(state_type)",
          "relation(has_state)"
        ],
        "fsm_transition/4": [
          "attribute(on)",
          "relation(has_state)",
          "relation(transitions_to)"
        ],
        "fsm_reachable/3": [
          "relation(has_state)",
          "relation(transitions_to)"
        ],
        "fsm_reachable_states/2": [
          "attribute(state_type)",
          "relation(has_state)",
          "relation(transitions_to)"
        ],
        "fsm_deterministic/1": [
          "attribute(on)",
          "relation(has_state)",
          "relation(transitions_to)"
        ],
        "fsm_nondeterministic_state/3": [
          "attribute(on)",
          "relation(has_state)",
          "relation(transitions_to)"
        ],
        "fsm_dead_state/2": [
          "attribute(state_type)",
          "relation(has_state)",
          "relation(transitions_to)"
        ],
        "fsm_unreachable_state/2": [
          "attribute(state_type)",
          "relation(has_state)",
          "relation(transitions_to)"
        ],
        "fsm_complete/1": [
          "attribute(current_state)",
          "attribute(state_type)",
          "relation(has_state)"
        ],
        "fsm_stuck/1": [
          "attribute(current_state)",
          "attribute(state_type)",
          "relation(has_state)",
          "relation(transitions_to)"
        ],
        "fsm_stuck_at/2": [
          "attribute(current_state)",
          "attribute(state_type)",
          "relation(has_state)",
          "relation(transitions_to)"
        ],
        "fsm_visited/2": [
          "relation(visited)"
        ],
        "fsm_trace/4": [
          "attribute(event)",
          "attribute(from_state)",
          "attribute(to_state)",
          "relation(trace_step)"
        ],
        "fsm_trace_length/2": [
          "attribute(event)",
          "attribute(from_state)",
          "attribute(to_state)",
          "relation(trace_step)"
        ],
        "fsm_cycle/2": [
          "relation(has_state)",
          "relation(transitions_to)"
        ],
        "fsm_shortest_path/4": [
          "relation(has_state)",
          "relation(transitions_to)"
        ],
        "fsm_all_paths/4": [
          "relation(has_state)",
          "relation(transitions_to)"
        ],
        "fsm_machines/1": [
          "attribute(machine_type)"
        ],
        "fsm_validate/2": [
          "attribute(on)",
          "attribute(state_type)",
          "relation(has_state)",
          "relation(transitions_to)"
        ]
      }
    },
    {
      "id": "temporal",
      "version": "1.0.0",
      "title": "Temporal Reasoning",
      "description": "Ordering, overlap, gap, and deadline reasoning over timestamped facts. Assert timestamps and intervals as attributes; query event ordering, concurrency, sequence validity, and imminent deadlines at zero token cost. Domain-agnostic.",
      "category": "reasoning",
      "license": "Elastic-2.0",
      "tags": [
        "temporal",
        "time",
        "deadlines",
        "events",
        "reasoning"
      ],
      "predicates": [
        "event_before/2",
        "event_after/2",
        "event_within/3",
        "event_concurrent/2",
        "deadline_passed/2",
        "deadline_imminent/3",
        "duration_between/3",
        "gap_between/3",
        "events_in_order/1",
        "next_event/3",
        "latest_event/2",
        "earliest_event/2"
      ],
      "rules_url": "https://raw.githubusercontent.com/datagrout/logic-batteries/main/modules/reasoning/temporal/temporal.pl",
      "readme_url": "https://github.com/datagrout/logic-batteries/tree/main/modules/reasoning/temporal",
      "install": "batteries.install_many",
      "tests_file": "test/reasoning/temporal_test.pl",
      "inputs": [
        {
          "role": "event",
          "kind": "attribute",
          "name": "timestamp",
          "type": "number",
          "presence": "key",
          "note": "When the point event happened, on the caller's one time scale."
        },
        {
          "role": "interval",
          "kind": "attribute",
          "name": "start",
          "type": "number",
          "presence": "key",
          "note": "When the interval begins, for event_concurrent and gap_between."
        },
        {
          "role": "interval",
          "kind": "attribute",
          "name": "end",
          "type": "number",
          "presence": "required",
          "note": "When the interval ends; without it the interval overlaps nothing and has no gap."
        },
        {
          "role": "task",
          "kind": "attribute",
          "name": "deadline",
          "type": "number",
          "presence": "key",
          "note": "When the task is due, compared with the Now the caller passes."
        }
      ],
      "reads": {
        "event_before/2": [
          "attribute(timestamp)"
        ],
        "event_after/2": [
          "attribute(timestamp)"
        ],
        "event_within/3": [
          "attribute(timestamp)"
        ],
        "event_concurrent/2": [
          "attribute(end)",
          "attribute(start)"
        ],
        "deadline_passed/2": [
          "attribute(deadline)"
        ],
        "deadline_imminent/3": [
          "attribute(deadline)"
        ],
        "duration_between/3": [
          "attribute(timestamp)"
        ],
        "gap_between/3": [
          "attribute(end)",
          "attribute(start)"
        ],
        "events_in_order/1": [
          "attribute(timestamp)"
        ],
        "next_event/3": [
          "attribute(timestamp)"
        ],
        "latest_event/2": [
          "attribute(timestamp)"
        ],
        "earliest_event/2": [
          "attribute(timestamp)"
        ]
      }
    },
