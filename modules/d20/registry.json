        {
          "role": "creature",
          "kind": "attribute",
          "name": "attack_bonus",
          "type": "integer",
          "presence": "optional",
          "note": "Stated total attack bonus that overrides the derived one for every attack type."
        },
        {
          "role": "creature",
          "kind": "attribute",
          "name": "attack_ability",
          "type": {
            "enum": [
              "str",
              "dex",
              "con",
              "int",
              "wis",
              "cha"
            ]
          },
          "presence": "optional",
          "note": "Ability for weapon attacks; absent, melee uses str and ranged uses dex."
