    {
      "id": "d20-combat",
      "version": "1.0.0",
      "title": "d20 Combat",
      "description": "AC-based hit resolution (natural 1/20 rules), damage calculation with ability modifier, critical hits, physical damage subcategory grouping (slashing/piercing/bludgeoning \u2192 physical), resistance/immunity/vulnerability, initiative ordering via keysort, advantage/disadvantage derivation from conditions and terrain, and action gating.",
      "category": "d20",
      "license": "Elastic-2.0 AND CC-BY-4.0",
      "tags": [
        "d20",
        "srd",
        "combat",
        "rpg",
        "initiative",
        "armor-class"
      ],
      "predicates": [
        "hits_ac/3",
        "hits_ac/4",
        "d20_damage/4",
        "d20_crit_damage/4",
        "d20_is_defeated/1",
        "d20_initiative_order/2",
        "d20_resistance/3",
        "d20_damage_category/2",
        "advantage_on_attack/2",
        "disadvantage_on_attack/2",
        "d20_can_attack/2",
        "d20_attack_roll_mode/3",
        "d20_death_save/2",
        "d20_instant_death/2"
      ],
      "requires": [
        "d20-core",
        "d20-conditions"
      ],
      "recommends": [
        "d20-conditions"
      ],
      "rules_url": "https://raw.githubusercontent.com/datagrout/logic-batteries/main/modules/d20/d20-combat/d20_combat.pl",
      "readme_url": "https://github.com/datagrout/logic-batteries/tree/main/modules/d20/d20-combat",
      "install": "batteries.install_many",
      "tests_file": "test/d20/d20_combat_test.pl",
      "inputs": [
        {
          "role": "creature",
          "kind": "attribute",
          "name": "hp",
          "type": "integer",
          "presence": "key",
          "note": "Current hit points; at 0 or below the creature is defeated, and without them it never is."
        },
        {
          "role": "creature",
          "kind": "attribute",
          "name": "hp_max",
          "type": "integer",
          "presence": "optional",
          "note": "Hit point maximum, the bar for instant death; without it there is none."
        },
        {
          "role": "creature",
          "kind": "attribute",
          "name": "ac",
          "type": "integer",
          "presence": "optional",
          "note": "Stated armor class that overrides the derived one."
        },
        {
          "role": "creature",
          "kind": "attribute",
          "name": "armor_base_ac",
          "type": "integer",
          "presence": "optional",
          "note": "Armor base for derived AC; without it the base is 10 and dex always adds."
        },
        {
          "role": "creature",
          "kind": "attribute",
          "name": "no_dex_to_ac",
          "type": "bool",
          "presence": {
            "default": "false"
          },
          "note": "true stops dex adding to armor_base_ac (heavy armor)."
        },
        {
          "role": "creature",
          "kind": "attribute",
          "name": "shield",
          "type": "bool",
          "presence": {
            "default": "false"
          },
          "note": "true adds 2 to derived AC."
        },
        {
          "role": "creature",
          "kind": "attribute",
          "name": "initiative",
          "type": "integer",
          "presence": "optional",
          "note": "Rolled initiative; without it the dex modifier orders the creature."
        },
        {
          "role": "creature",
          "kind": "attribute",
          "name": "damage_type",
          "type": "atom",
          "presence": {
            "default": "bludgeoning"
          },
          "note": "Damage type the creature deals, matched against the target's damage flags."
        },
        {
          "role": "creature",
          "kind": "attribute",
          "name": "damage_bonus",
          "type": "integer",
          "presence": "optional",
          "note": "Stated flat damage bonus that overrides the ability modifier."
        },
        {
          "role": "creature",
          "kind": "attribute",
          "name": "damage_ability",
          "type": {
            "enum": [
              "str",
              "dex",
              "con",
              "int",
              "wis",
              "cha"
            ]
          },
          "presence": "optional",
          "note": "Ability whose modifier adds to damage; absent, str or the finesse best of str and dex."
        },
        {
          "role": "creature",
          "kind": "attribute",
          "name": "finesse_attack",
          "type": "bool",
          "presence": {
            "default": "false"
          },
          "note": "true makes damage use the better of the str and dex modifiers."
        },
        {
          "role": "creature",
          "kind": "relation",
          "name": "adjacent_to",
          "type": {
            "ref": "creature"
          },
          "presence": "optional",
          "note": "Within reach of the target: a prone target gives advantage, otherwise disadvantage."
        },
        {
          "role": "creature",
          "kind": "relation",
          "name": "can_see",
          "type": {
            "ref": "creature"
          },
          "presence": "optional",
          "note": "Sees the target; a frightened attacker that does has disadvantage."
        },
        {
          "role": "creature",
          "kind": "relation",
          "name": "flanking",
          "type": {
            "ref": "creature"
          },
          "presence": "optional",
          "note": "Flanks the target, for advantage."
        },
        {
          "role": "creature",
          "kind": "relation",
          "name": "has_high_ground_vs",
          "type": {
            "ref": "creature"
          },
          "presence": "optional",
          "note": "Holds high ground over the target, for advantage."
        },
        {
          "role": "creature",
          "kind": "relation",
          "name": "has_cover_vs",
          "type": {
            "ref": "creature"
          },
          "presence": "optional",
          "note": "Cover stands between this attacker and the target, so the attacker has disadvantage."
        },
        {
          "role": "creature",
          "kind": "relation",
          "name": "out_of_range",
          "type": {
            "ref": "creature"
          },
          "presence": "optional",
          "note": "The target is out of range, so the attacker cannot attack it."
        }
      ],
      "reads": {
        "hits_ac/3": [
          "attribute(ac)",
          "attribute(armor_base_ac)",
          "attribute(no_dex_to_ac)",
          "attribute(shield)"
        ],
        "hits_ac/4": [
          "attribute(ac)",
          "attribute(armor_base_ac)",
          "attribute(no_dex_to_ac)",
          "attribute(shield)"
        ],
        "d20_damage/4": [
          "attribute(ac)",
          "attribute(armor_base_ac)",
          "attribute(damage_ability)",
          "attribute(damage_bonus)",
          "attribute(damage_type)",
          "attribute(finesse_attack)",
          "attribute(hp)",
          "attribute(hp_max)",
          "attribute(initiative)",
          "attribute(no_dex_to_ac)",
          "attribute(shield)"
        ],
        "d20_crit_damage/4": [
          "attribute(ac)",
          "attribute(armor_base_ac)",
          "attribute(damage_ability)",
          "attribute(damage_bonus)",
          "attribute(damage_type)",
          "attribute(finesse_attack)",
          "attribute(hp)",
          "attribute(hp_max)",
          "attribute(initiative)",
          "attribute(no_dex_to_ac)",
          "attribute(shield)"
        ],
        "d20_is_defeated/1": [
          "attribute(hp)"
        ],
        "d20_initiative_order/2": [
          "attribute(initiative)"
        ],
        "d20_resistance/3": [
          "attribute(ac)",
          "attribute(armor_base_ac)",
          "attribute(damage_ability)",
          "attribute(damage_bonus)",
          "attribute(damage_type)",
          "attribute(finesse_attack)",
          "attribute(hp)",
          "attribute(hp_max)",
          "attribute(initiative)",
          "attribute(no_dex_to_ac)",
          "attribute(shield)"
        ],
        "d20_damage_category/2": [],
        "advantage_on_attack/2": [
          "relation(adjacent_to)",
          "relation(flanking)",
          "relation(has_high_ground_vs)"
        ],
        "disadvantage_on_attack/2": [
          "relation(adjacent_to)",
          "relation(can_see)",
          "relation(has_cover_vs)"
        ],
        "d20_can_attack/2": [
          "attribute(hp)",
          "relation(out_of_range)"
        ],
        "d20_attack_roll_mode/3": [
          "relation(adjacent_to)",
          "relation(can_see)",
          "relation(flanking)",
          "relation(has_cover_vs)",
          "relation(has_high_ground_vs)"
        ],
        "d20_death_save/2": [],
        "d20_instant_death/2": [
          "attribute(hp_max)"
        ]
      }
    },
    {
