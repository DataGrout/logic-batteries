              "grappled",
              "incapacitated",
              "invisible",
              "paralyzed",
              "petrified",
              "poisoned",
              "prone",
              "restrained",
              "stunned",
              "unconscious"
            ]
          },
          "presence": "key",
          "note": "One fact per active SRD condition; any other name is active but has no effect."
