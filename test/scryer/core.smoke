# core battery on scryer-prolog
modules/core/core/core.pl
---
core_even(X) :- X mod 2 =:= 0.
core_add(X, A0, A) :- A is A0 + X.
check(Name, Goal) :- ( call(Goal) -> true ; write(fail(Name)), nl, halt(1) ).
smoke :-
    check(max, (core_max_list([3,9,2], 9), core_min_list([3,9,2], 2))),
    check(argmax, (core_argmax([3-a,9-b,9-c], b), core_argmin([3-a,2-b,2-c], b))),
    check(mean, (core_mean([1,2,3,4], M), M =:= 2.5)),
    check(median, (core_median([5,1,3], 3), core_median([4,1,3,2], Md), Md =:= 2.5)),
    check(msort, core_msort([c,a,b,a], [a,a,b,c])),
    check(keysort, core_keysort([2-b,1-z,2-a,1-y], [1-z,1-y,2-b,2-a])),
    check(group, core_group_pairs([1-a,1-b,2-c], [1-[a,b],2-[c]])),
    check(unique, core_unique([b,a,b,c,a], [b,a,c])),
    check(between, (findall(X, core_between(1,3,X), [1,2,3]), core_numlist(2,4,[2,3,4]))),
    check(subtract, (core_subtract([a,b,c,b],[b],[a,c]), core_flatten([a,[b,[c]],[]],[a,b,c]), core_zip([a,b],[1,2],[a-1,b-2]))),
    check(take_drop, (core_take(2,[a,b,c],[a,b]), core_drop(2,[a,b,c],[c]), core_last([a,b,c],c))),
    check(higher_order, (core_include(core_even,[1,2,3,4],[2,4]), core_exclude(core_even,[1,2,3,4],[1,3]), core_foldl(core_add,[1,2,3],0,6), core_forall(member(Y,[2,4]), core_even(Y)))),
    write(smoke_ok), nl, halt.
